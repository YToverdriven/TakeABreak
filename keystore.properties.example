# Copy this file to keystore.properties (git-ignored) and fill in your release keystore details.
# Both :takeabreak and :takeabreak-watcher read this file so both release APKs share the same
# signing key (required for signature-protected broadcasts between the two apps).
# Use forward slashes if specifying an absolute path on Windows.
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=takeabreak
keyPassword=CHANGE_ME
